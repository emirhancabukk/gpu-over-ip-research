From fb4987d45d9380f1ecac031dfadcf14909d0b62a Mon Sep 17 00:00:00 2001
From: Emirhan Cabuk <emirhancabuk30@gmail.com>
Date: Mon, 31 Aug 2026 16:33:20 +0300
Subject: [PATCH 1/2] virtio/vulkan: TCP transport for vtest with shared-memory
 emulation

Venus normally shares the command ring and reply pool with the host as
real shared memory (memfd + SCM_RIGHTS + MAP_SHARED). Neither fd passing
nor shared memory exists across a TCP socket, so coherence is emulated
on the wire.

- vtest_connect_socket_tcp: accept "tcp:<host>:<port>" in
  VTEST_SOCKET_NAME, AF_INET + TCP_NODELAY.
- vtest_shmem_create: fall back to MAP_SHARED|MAP_ANONYMOUS when no fd
  can be received.
- vtest_shmem_sync_ring_cycle: field-ownership-aware sync. Only
  guest-owned regions (tail, buffer) are PUT, only host-owned regions
  (head, status, extra) are GET. Blind bidirectional copying corrupted
  both sides. Buffer is pushed before tail to preserve SPSC discipline.
- Ring delta-push: track ring->cur and PUT only [last_pushed, cur),
  not the full 128 KiB buffer. Wrap-around handled as a two-part PUT.
- Merge the head (offset 0) and status (offset 128) GET into one
  round trip.
- Reply pool is GET-only (host is sole writer) and delta-pulled via a
  hint_size parameter plus last_synced_size state, so only
  [last_synced_size, hint_size) crosses the wire.
- Fix a race where ring->cur was read outside the mutex while
  last_pushed_cur was updated inside it, letting last_pushed_cur move
  backwards and abort in vn_ring_submit_internal.
- Pipelining: drop the unconditional shmem_sync_now at submit time.
  Async commands no longer each pay a round trip; delivery is
  guaranteed by the next synchronous wait_seqno or by the low-frequency
  background thread. Measured 435s -> 236s over a real WAN link.
- Background sync thread period relaxed to 100 ms for the reply pool.
- Suppress the AF_UNIX dummy byte in vtest_send_fd on TCP, which
  otherwise desynchronised the byte stream.
- vtest_vcmd_sync_wait: no fd to poll on TCP, return success. Correct
  for enumeration workloads only; real async fences need a host->guest
  notification channel.

Base: e9a87f8 (upstream/main)
---
 src/virtio/vulkan/vn_renderer.h       |  70 +++
 src/virtio/vulkan/vn_renderer_vtest.c | 685 +++++++++++++++++++++++++-
 src/virtio/vulkan/vn_ring.c           |  91 ++++
 3 files changed, 824 insertions(+), 22 deletions(-)

diff --git a/src/virtio/vulkan/vn_renderer.h b/src/virtio/vulkan/vn_renderer.h
index ea224ea..9c2f9c9 100644
--- a/src/virtio/vulkan/vn_renderer.h
+++ b/src/virtio/vulkan/vn_renderer.h
@@ -133,6 +133,48 @@ struct vn_renderer_shmem_ops {
                                        size_t size);
    void (*destroy)(struct vn_renderer *renderer,
                    struct vn_renderer_shmem *shmem);
+   /* EXPERIMENTAL (Faz 3, GPU-over-IP research): optional (NULL for
+    * renderers that don't need it, e.g. real virtio-gpu with true shared
+    * memory). Forces an immediate, synchronous refresh of this shmem's
+    * local mapping from the host's copy. Used to close a happens-before
+    * gap in the TCP/vtest transport: our reply-pool shmem is normally
+    * kept "fresh" by a background poll thread, but that thread's cadence
+    * gives no hard guarantee the latest host-written reply has landed by
+    * the time vn_ring_wait_seqno() returns and the caller reads it. Right
+    * after that return is exactly the one point where we *know* (from
+    * Venus's own ordering guarantee: host never advances the ring seqno
+    * before finishing the reply write) that a fresh pull will see the
+    * real data -- see the call site in vn_ring.c. */
+   /* EXPERIMENTAL (Faz 4, AWS WAN perf): hint_size, when nonzero and
+    * smaller than the shmem's full size, tells the renderer it only needs
+    * to refresh the first hint_size bytes (the caller knows that's all
+    * that could possibly be valid/used right now, e.g. reply_shmem_pool's
+    * own `used` byte count) instead of pulling the whole shmem over the
+    * network. A renderer is free to ignore this and always pull the full
+    * size; it's purely an optimization hint, never a correctness
+    * requirement. Pass 0 to request a full sync (original behavior). */
+   void (*sync_now)(struct vn_renderer *renderer,
+                    struct vn_renderer_shmem *shmem,
+                    size_t hint_size);
+
+   /* EXPERIMENTAL (Faz 4, AWS WAN correctness fix): optional (NULL for
+    * renderers that don't need it, e.g. real virtio-gpu, which has no
+    * concurrent background copier touching the shmem). vn_ring_submit's
+    * write-then-publish sequence (vn_ring_write_buffer, then
+    * vn_ring_store_tail, then a sync_now push) is only atomic against a
+    * renderer's own background sync thread if the renderer says so --
+    * nothing in vn_ring.c itself takes any lock around that sequence.
+    * Reproduced without this: over a real WAN link with multi-second
+    * sync_now round trips, the vtest renderer's low-frequency background
+    * copier could win the shmem lock in the middle of the guest's own
+    * write_buffer loop and PUT a partially-written ring buffer to the
+    * host -- decoded there as "32 bytes correct, rest zero", a fatal CS
+    * error (see experiments/phase4-wan-aws/). Call lock() before writing
+    * to a shmem that a background thread might also touch, unlock() when
+    * done publishing. */
+   void (*lock)(struct vn_renderer *renderer, struct vn_renderer_shmem *shmem);
+   void (*unlock)(struct vn_renderer *renderer,
+                  struct vn_renderer_shmem *shmem);
 };
 
 struct vn_renderer_bo_ops {
@@ -284,6 +326,34 @@ vn_renderer_shmem_create(struct vn_renderer *renderer, size_t size)
    return shmem;
 }
 
+/* EXPERIMENTAL (Faz 3): see the comment on vn_renderer_shmem_ops::sync_now.
+ * No-op when the renderer doesn't provide sync_now or shmem is NULL. */
+static inline void
+vn_renderer_shmem_sync_now(struct vn_renderer *renderer,
+                           struct vn_renderer_shmem *shmem,
+                           size_t hint_size)
+{
+   if (shmem && renderer->shmem_ops.sync_now)
+      renderer->shmem_ops.sync_now(renderer, shmem, hint_size);
+}
+
+/* EXPERIMENTAL (Faz 4): see the comment on vn_renderer_shmem_ops::lock. */
+static inline void
+vn_renderer_shmem_lock(struct vn_renderer *renderer,
+                       struct vn_renderer_shmem *shmem)
+{
+   if (shmem && renderer->shmem_ops.lock)
+      renderer->shmem_ops.lock(renderer, shmem);
+}
+
+static inline void
+vn_renderer_shmem_unlock(struct vn_renderer *renderer,
+                         struct vn_renderer_shmem *shmem)
+{
+   if (shmem && renderer->shmem_ops.unlock)
+      renderer->shmem_ops.unlock(renderer, shmem);
+}
+
 static inline struct vn_renderer_shmem *
 vn_renderer_shmem_ref(struct vn_renderer *renderer,
                       struct vn_renderer_shmem *shmem)
