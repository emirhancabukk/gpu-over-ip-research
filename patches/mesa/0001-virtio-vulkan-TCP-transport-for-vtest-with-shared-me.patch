index 298ebd6..0aec2b1 100644
--- a/src/virtio/vulkan/vn_renderer_vtest.c
+++ b/src/virtio/vulkan/vn_renderer_vtest.c
@@ -7,8 +7,10 @@
  */
 
 #include "virtio/virtio-gpu/venus_hw.h"
+#include <arpa/inet.h>
 #include <errno.h>
 #include <netinet/in.h>
+#include <netinet/tcp.h>
 #include <poll.h>
 #include <sys/mman.h>
 #include <sys/socket.h>
@@ -32,6 +34,42 @@ struct vtest;
 
 struct vtest_shmem {
    struct vn_renderer_shmem base;
+
+   /* EXPERIMENTAL (Faz 3): under TCP transport there is no SCM_RIGHTS fd to
+    * mmap MAP_SHARED with the host, so this shmem is backed by a local
+    * anonymous mapping and a background thread periodically pushes/pulls
+    * its contents to/from the host via transfer_put2/transfer_get2 to
+    * emulate coherency. Known limitation: no locking against concurrent
+    * vn_ring writes into the same memory -- good enough to prove the
+    * transport works, not yet safe/fast. See experiments/phase3-lan-transport/.
+    */
+   struct vtest *sync_vtest;
+   thrd_t sync_thread;
+   atomic_bool sync_running;
+   bool sync_active;
+
+   /* EXPERIMENTAL (Faz 4, AWS WAN perf): tracks the ring "cur" counter value
+    * (same monotonic counter as vn_ring's own ring->cur / the tail field --
+    * see vn_ring_write_buffer() in vn_ring.c) as of the last time we PUT the
+    * buffer to the host, so the next cycle only needs to push the bytes
+    * actually written since then instead of the full 128KB every time. See
+    * experiments/phase4-wan-aws/ for the profiling that motivated this. */
+   uint32_t last_pushed_cur;
+   bool last_pushed_cur_valid;
+
+   /* EXPERIMENTAL (Faz 4, AWS WAN perf): for the reply_shmem_pool, tracks
+    * how many bytes from offset 0 we've already pulled. reply_shmem_pool's
+    * `used` counter (passed in as hint_size) is a bump allocator that only
+    * ever grows across the whole instance lifetime -- it does NOT mean
+    * "this call's reply size", it means "cumulative total ever allocated".
+    * Pulling [0, used) every time re-fetches every earlier call's reply
+    * data all over again, growing without bound over a run (this is what
+    * made the very first profiling look great -- ~60ms -- and the full
+    * vulkaninfo run look no better than before -- ~510ms average -- despite
+    * the "optimization": early calls had small `used`, later calls had
+    * `used` approaching the full 1MB). Only pulling the new
+    * [last_synced_size, hint_size) span fixes this for real. */
+   size_t last_synced_size;
 };
 
 struct vtest_bo {
@@ -53,6 +91,11 @@ struct vtest {
 
    mtx_t sock_mutex;
    int sock_fd;
+   /* EXPERIMENTAL (Faz 3): true when connected via "tcp:host:port" instead
+    * of a unix socket -- SCM_RIGHTS fd-passing is unavailable, so blob
+    * resources fall back to a local-memory + transfer_get2/put2 emulation.
+    */
+   bool is_tcp;
 
    uint32_t protocol_version;
    uint32_t max_timeline_count;
@@ -71,12 +114,61 @@ struct vtest {
    struct vn_renderer_shmem_cache shmem_cache;
 };
 
+/* EXPERIMENTAL (Faz 3, GPU-over-IP research): if path is "tcp:<host>:<port>",
+ * connect over TCP instead of a unix domain socket. This lets the vtest
+ * renderer run on a remote machine (e.g. a cloud GPU instance) instead of
+ * requiring guest and host to share a filesystem/unix socket namespace.
+ */
+static int
+vtest_connect_socket_tcp(struct vn_instance *instance, const char *spec)
+{
+   char host[256];
+   const char *rest = spec + 4; /* skip "tcp:" */
+   const char *colon = strrchr(rest, ':');
+   if (!colon || (size_t)(colon - rest) >= sizeof(host))
+      return -1;
+
+   memcpy(host, rest, colon - rest);
+   host[colon - rest] = '\0';
+   const int port = atoi(colon + 1);
+
+   const int sock = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
+   if (sock < 0)
+      return -1;
+
+   struct sockaddr_in addr;
+   memset(&addr, 0, sizeof(addr));
+   addr.sin_family = AF_INET;
+   addr.sin_port = htons((uint16_t)port);
+   if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
+      close(sock);
+      return -1;
+   }
+
+   if (connect(sock, (struct sockaddr *)&addr, sizeof(addr)) == -1) {
+      if (VN_DEBUG(INIT)) {
+         vn_log(instance, "failed to connect to tcp %s:%d: %s", host, port,
+                strerror(errno));
+      }
+      close(sock);
+      return -1;
+   }
+
+   const int one = 1;
+   setsockopt(sock, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+
+   return sock;
+}
+
 static int
 vtest_connect_socket(struct vn_instance *instance, const char *path)
 {
    struct sockaddr_un un;
    int sock;
 
+   if (strncmp(path, "tcp:", 4) == 0)
+      return vtest_connect_socket_tcp(instance, path);
+
    sock = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
    if (sock < 0) {
       if (VN_DEBUG(INIT))
@@ -317,6 +409,344 @@ vtest_vcmd_context_init(struct vtest *vtest, uint32_t capset_id)
    vtest_write(vtest, vcmd_context_init, sizeof(vcmd_context_init));
 }
 
+/* EXPERIMENTAL (Faz 3): client-side counterparts of the server's
+ * transfer_get2/put2 handlers (vtest_transfer_get_internal/put_internal in
+ * virglrenderer), used only in TCP mode to emulate shared-memory coherency
+ * for blob resources. Treated as a flat 1D buffer (level 0, width=size,
+ * height=depth=1), matching how the server interprets the transfer box.
+ */
+/* NOTE (Faz 3, corrected): VCMD_TRANSFER_PUT2/GET2 turned out to silently
+ * ignore the client-sent size (server's vtest_transfer_decode_args2 never
+ * reads a DATA_SIZE field at all -- confirmed by reading vtest_renderer.c),
+ * so the wrapper functions that call *_internal() with data_size always
+ * pass 0 for the "2" opcodes, causing a 0-byte transfer while our client
+ * still wrote/expected `size` bytes -> stream desync. The *original*
+ * VCMD_TRANSFER_GET/PUT (opcodes 4/5, 11-dword header incl. DATA_SIZE) do
+ * wire the size through (vtest_transfer_decode_args reads
+ * thdr_buf[VCMD_TRANSFER_DATA_SIZE]) -- use those instead. */
+static void
+vtest_vcmd_transfer_put2(struct vtest *vtest, uint32_t res_id,
+                         const void *data, uint32_t size, uint32_t offset)
+{
+   uint32_t vtest_hdr[VTEST_HDR_SIZE];
+   uint32_t args[VCMD_TRANSFER_HDR_SIZE];
+
+   vtest_hdr[VTEST_CMD_LEN] = VCMD_TRANSFER_HDR_SIZE + (size + 3) / 4;
+   vtest_hdr[VTEST_CMD_ID] = VCMD_TRANSFER_PUT;
+
+   memset(args, 0, sizeof(args));
+   args[VCMD_TRANSFER_RES_HANDLE] = res_id;
+   args[VCMD_TRANSFER_STRIDE] = size;
+   args[VCMD_TRANSFER_LAYER_STRIDE] = size;
+   args[VCMD_TRANSFER_WIDTH] = size;
+   args[VCMD_TRANSFER_HEIGHT] = 1;
+   args[VCMD_TRANSFER_DEPTH] = 1;
+   args[VCMD_TRANSFER_DATA_SIZE] = size;
+   /* EXPERIMENTAL: the legacy PUT/GET wire format has no real offset field
+    * (server hardcodes args->offset=0). We repurpose the unused X box
+    * coordinate to carry our own byte offset -- the server-side blob
+    * fast path (added for Faz 3) reads it back via args->box.x instead of
+    * args->offset, so this is scoped entirely to our own blob code path
+    * and doesn't affect classic (non-blob) texture transfers. */
+   args[VCMD_TRANSFER_X] = offset;
+
+   vtest_write(vtest, vtest_hdr, sizeof(vtest_hdr));
+   vtest_write(vtest, args, sizeof(args));
+   if (size)
+      vtest_write(vtest, data, size);
+}
+
+static void
+vtest_vcmd_transfer_get2(struct vtest *vtest, uint32_t res_id, void *data,
+                         uint32_t size, uint32_t offset)
+{
+   uint32_t vtest_hdr[VTEST_HDR_SIZE];
+   uint32_t args[VCMD_TRANSFER_HDR_SIZE];
+
+   vtest_hdr[VTEST_CMD_LEN] = VCMD_TRANSFER_HDR_SIZE;
+   vtest_hdr[VTEST_CMD_ID] = VCMD_TRANSFER_GET;
+
+   memset(args, 0, sizeof(args));
+   args[VCMD_TRANSFER_RES_HANDLE] = res_id;
+   args[VCMD_TRANSFER_STRIDE] = size;
+   args[VCMD_TRANSFER_LAYER_STRIDE] = size;
+   args[VCMD_TRANSFER_WIDTH] = size;
+   args[VCMD_TRANSFER_HEIGHT] = 1;
+   args[VCMD_TRANSFER_DEPTH] = 1;
+   args[VCMD_TRANSFER_DATA_SIZE] = size;
+   /* see matching comment in vtest_vcmd_transfer_put2() */
+   args[VCMD_TRANSFER_X] = offset;
+
+   vtest_write(vtest, vtest_hdr, sizeof(vtest_hdr));
+   vtest_write(vtest, args, sizeof(args));
+   if (size)
+      vtest_read(vtest, data, size);
+}
+
+/* EXPERIMENTAL (Faz 3, corrected): the primary Venus ring's shmem is laid
+ * out by vn_ring_get_layout() (vn_ring.c) as:
+ *   [0]      head   (4B)  -- HOST-owned: host advances as it consumes cmds
+ *   [64]     tail   (4B)  -- GUEST-owned: guest advances as it enqueues
+ *   [128]    status (4B)  -- HOST-owned: e.g. the periodic ALIVE heartbeat
+ *   [192]    buffer (128KiB) -- GUEST-owned: the command data itself
+ *   [131264] extra  (4B)  -- HOST-owned (never written by the guest side)
+ *   total shmem_size = 131268, matching vn_instance.c's fixed
+ *   buf_size=128*1024 / extra_size=4 for the primary ring.
+ *
+ * A blind whole-buffer bidirectional copy (PUT everything, then GET
+ * everything) was found to corrupt this: every PUT re-pushes the guest's
+ * stale local copy of the HOST-owned fields (head/status), silently
+ * reverting any progress the host made between our cycles -- e.g. erasing
+ * the host's ALIVE heartbeat and even rolling back its own `head` pointer.
+ * This reliably starved vn_relax's watchdog, aborting well within its
+ * budget regardless of polling speed. Fix: only PUT the guest-owned
+ * ranges (tail, buffer) and only GET the host-owned ranges (head, status,
+ * extra) -- never let one side's blind copy stomp the other's fields.
+ * Uses the box.x-as-offset extension (see vtest_vcmd_transfer_put2/get2)
+ * since the legacy PUT/GET opcode has no real offset field of its own.
+ */
+#define VN_RING_HEAD_OFFSET 0
+#define VN_RING_TAIL_OFFSET 64
+#define VN_RING_STATUS_OFFSET 128
+#define VN_RING_BUFFER_OFFSET 192
+#define VN_RING_BUFFER_SIZE (128 * 1024)
+#define VN_RING_EXTRA_OFFSET (VN_RING_BUFFER_OFFSET + VN_RING_BUFFER_SIZE)
+#define VN_RING_EXTRA_SIZE 4
+#define VN_RING_SHMEM_SIZE (VN_RING_EXTRA_OFFSET + VN_RING_EXTRA_SIZE)
+
+static void
+vtest_shmem_sync_ring_cycle(struct vtest *vtest, struct vtest_shmem *shmem)
+{
+   const uint32_t res_id = shmem->base.res_id;
+   char *ptr = shmem->base.mmap_ptr;
+
+   /* EXPERIMENTAL: one critical section for the whole cycle. An earlier
+    * version split this into 5 separate lock/unlock pairs to be "fairer"
+    * to the reply-pool sync thread, but that over-corrected: the ring is
+    * the actual critical path (nothing else can make progress until it
+    * delivers), and splitting it let the reply-pool thread win the mutex
+    * so often that the ring itself starved instead, so the host never
+    * got far enough to have a reply to write. Keep the ring's cycle
+    * atomic and let the inter-cycle sleep below be the fairness point
+    * instead (tuned so the reply-pool thread, which sleeps longer, still
+    * gets turns without starving the ring). */
+   mtx_lock(&vtest->sock_mutex);
+
+   /* EXPERIMENTAL (Faz 4, AWS WAN perf, bugfix): must read `cur` AFTER
+    * taking the mutex, not before. This function runs concurrently from
+    * two callers -- the low-frequency background thread and the active
+    * sync_now hook -- and last_pushed_cur is only mutex-protected at the
+    * point it's compared/updated below. Reading `cur` outside the lock let
+    * a thread capture a stale snapshot, lose the race for the mutex to the
+    * other thread (which pushes using a newer cur and advances
+    * last_pushed_cur past what the stale thread saw), and then overwrite
+    * last_pushed_cur backwards with its own older value once it finally
+    * got the lock -- corrupting the delta bookkeeping. Reproduced as
+    * vn_ring_submit_internal() aborting (ring assert) after several
+    * seconds of the ring cycle intermittently taking 2-5s per call instead
+    * of ~120ms -- see experiments/phase4-wan-aws/. */
+   uint32_t cur;
+   memcpy(&cur, ptr + VN_RING_TAIL_OFFSET, 4);
+
+   /* EXPERIMENTAL (Faz 4, AWS WAN perf): only push the bytes actually
+    * written since our last cycle instead of the full 128KB buffer every
+    * time. Profiling a real vulkaninfo run over a real AWS WAN link (see
+    * experiments/phase4-wan-aws/) found sync_now round trips averaging
+    * ~730ms and dominating >85% of total time; pushing all 128KB on every
+    * single-command ring cycle (when usually only a few hundred bytes
+    * actually changed) was a direct contributor. ring->cur (mirrored into
+    * the tail field -- see vn_ring_write_buffer() in vn_ring.c) is a
+    * monotonic counter, so cur - last_pushed_cur (unsigned wraparound-safe
+    * subtraction) gives the exact number of new bytes. Falls back to a
+    * full-buffer push on the first cycle, or if somehow more than a full
+    * buffer's worth landed between cycles. */
+   const uint32_t delta = shmem->last_pushed_cur_valid
+                              ? cur - shmem->last_pushed_cur
+                              : VN_RING_BUFFER_SIZE;
+   if (delta > 0 && delta < VN_RING_BUFFER_SIZE) {
+      const uint32_t mask = VN_RING_BUFFER_SIZE - 1;
+      const uint32_t start = shmem->last_pushed_cur & mask;
+      if (start + delta <= VN_RING_BUFFER_SIZE) {
+         vtest_vcmd_transfer_put2(vtest, res_id,
+                                  ptr + VN_RING_BUFFER_OFFSET + start, delta,
+                                  VN_RING_BUFFER_OFFSET + start);
+      } else {
+         const uint32_t first = VN_RING_BUFFER_SIZE - start;
+         vtest_vcmd_transfer_put2(vtest, res_id,
+                                  ptr + VN_RING_BUFFER_OFFSET + start, first,
+                                  VN_RING_BUFFER_OFFSET + start);
+         vtest_vcmd_transfer_put2(vtest, res_id, ptr + VN_RING_BUFFER_OFFSET,
+                                  delta - first, VN_RING_BUFFER_OFFSET);
+      }
+   } else if (delta >= VN_RING_BUFFER_SIZE) {
+      vtest_vcmd_transfer_put2(vtest, res_id, ptr + VN_RING_BUFFER_OFFSET,
+                               VN_RING_BUFFER_SIZE, VN_RING_BUFFER_OFFSET);
+   }
+   shmem->last_pushed_cur = cur;
+   shmem->last_pushed_cur_valid = true;
+
+   /* push guest-owned fields -- buffer content MUST land before the tail
+    * pointer that publishes it: the host runs an independent ring-consumer
+    * thread that wakes on tail changes and immediately decodes up to the
+    * new tail, concurrently with our own main-thread dispatch loop. If we
+    * published tail first, that consumer thread could race ahead and
+    * decode stale/old buffer bytes before the PUT above lands, corrupting
+    * the venus command stream (this was exactly the "vkCreateInstance
+    * resulted in CS error" / "vn_dispatch_command failed" failure seen
+    * before this fix). Publish data, then the index -- the same discipline
+    * a lock-free SPSC ring needs. */
+   vtest_vcmd_transfer_put2(vtest, res_id, ptr + VN_RING_TAIL_OFFSET, 4,
+                            VN_RING_TAIL_OFFSET);
+
+   /* pull host-owned fields: head (offset 0) and status (offset 128) are
+    * close enough that pulling the whole [0, VN_RING_STATUS_OFFSET+4) span
+    * in ONE round trip instead of two separate GETs is a straight win (the
+    * unused gap bytes in between are just discarded). extra sits right
+    * after the 128KB buffer, far away, so it stays its own GET rather than
+    * pulling the whole buffer-sized gap to reach it. */
+   char head_and_status[VN_RING_STATUS_OFFSET + 4];
+   vtest_vcmd_transfer_get2(vtest, res_id, head_and_status,
+                            sizeof(head_and_status), VN_RING_HEAD_OFFSET);
+   memcpy(ptr + VN_RING_HEAD_OFFSET, head_and_status, 4);
+   memcpy(ptr + VN_RING_STATUS_OFFSET,
+          head_and_status + VN_RING_STATUS_OFFSET, 4);
+
+   vtest_vcmd_transfer_get2(vtest, res_id, ptr + VN_RING_EXTRA_OFFSET, 4,
+                            VN_RING_EXTRA_OFFSET);
+   mtx_unlock(&vtest->sock_mutex);
+}
+
+/* EXPERIMENTAL (Faz 3): background thread that keeps a TCP-mode blob's
+ * local anonymous mapping approximately coherent with the host's copy.
